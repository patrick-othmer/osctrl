# osctrl production stack — environment configuration.
#
# Copy to .env next to docker-compose.yml and fill in real values:
#   cp .env.example .env && chmod 600 .env
# Never commit the .env file or anything under ./secrets/.

# Image / build versions (keep in sync with the release you deploy)
OSCTRL_VERSION=0.5.9
GOLANG_VERSION=1.27.1
NODE_VERSION=22
OSQUERY_VERSION=5.23.1
NGINX_VERSION=1.31-alpine
POSTGRES_VERSION=16-alpine
VALKEY_VERSION=8-alpine

# Build metadata stamped into the binaries (informational)
BUILD_COMMIT=unknown

# Public hostname of the osquery endpoint. Agents enroll via
# https://${OSCTRL_TLS_HOST}/<env-uuid>/enroll — DNS must point at the
# host running osctrl-edge.
OSCTRL_TLS_HOST=osquery.example.com

# Host ports published for the two public entrypoints.
OSCTRL_TLS_PORT=443
OSCTRL_UI_PORT=8443

# One-shot bootstrap (environment + admin user)
OSCTRL_ENV_NAME=prod
OSCTRL_USER=admin
OSCTRL_PASS=Changeme123!

# Posture profile applied to the environment at bootstrap
POSTURE_PROFILE=linux-server
POSTURE_INTERVAL=75
POSTURE_QUERY_PREFIX=osctrl:posture:

# PostgreSQL
POSTGRES_DB_NAME=osctrl
POSTGRES_DB_USERNAME=osctrl
POSTGRES_DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# Valkey (Redis-compatible cache)
VALKEY_PASSWORD=CHANGE_ME_VALKEY_PASSWORD

# osctrl-api JWT signing key. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET

# osctrl-tls log destination (db|stdout|none|...)
OSCTRL_TLS_LOGGER=db

# Frontend TLS mode: 1 = HTTPS on :443 using ./secrets/osctrl.{crt,key},
# 0 = plain HTTP on :80 behind an external TLS terminator.
OSCTRL_FRONTEND_TLS=1

# CIDR of the docker networks to trust for X-Forwarded-For
# (user-defined compose networks live inside 172.16.0.0/12).
OSCTRL_TRUSTED_PROXIES=172.16.0.0/12
