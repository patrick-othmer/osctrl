# syntax=docker/dockerfile:1
# osctrl-edge — production image for the osquery-facing nginx.
#
# Terminates TLS for the agent endpoint (enroll/config/log/query/carve) and
# proxies to osctrl-tls:9000. There is nothing to compile here, so this
# image is a thin nginx layer on top of the official image; certificates
# are mounted at runtime from ./secrets/ — never baked in.

ARG NGINX_VERSION=1.31-alpine
FROM nginx:${NGINX_VERSION}

# Placeholder cert files so the host bind mounts land on files: some runc
# versions auto-create missing mount destinations as directories, which
# makes the file mount fail with a not-a-directory error.
RUN rm -f /etc/nginx/conf.d/default.conf && \
    mkdir -p /etc/ssl/osctrl && \
    touch /etc/ssl/osctrl/tls.crt /etc/ssl/osctrl/tls.key

COPY deploy/prod/conf/nginx/edge.conf /etc/nginx/conf.d/edge.conf

EXPOSE 443
